#!/usr/bin/env bash
#
# SPDX-FileCopyrightText: Björn Busse <bj.rn@baerlin.eu>
# SPDX-License-Identifier: BSD-3-Clause
#
# Usage: ./run [path-to-disk.raw]
#        ./run download [target] [arch]
#
# download fetches the newest disk image artifact from the Create Disk Image
# workflow and unpacks it sparsely. A plain unzip writes all 16 GiB including
# every zero block, which fills a disk and leaves a truncated image whose
# rootfs partition runs past EOF - the guest then boots far enough to read the
# partition table and fails to find its root
#
# Environment:
#   ARCH         Target arch to boot (amd64|arm64). Defaults to the host arch.
#   DISK_IMAGE   Disk image to boot. Defaults to gentoo-containeros-<ARCH>.raw
#   SERIAL_PIPE  Base path of a mkfifo pair (<base>.in/<base>.out). When set,
#                the guest console is wired to it instead of the terminal.
#   QEMU_NET     user|vmnet-shared|none. Defaults to vmnet-shared on macOS
#                (needs root) and user everywhere else. Use none when qemu was
#                built without libslirp.
#   QEMU_ACCEL   Accelerator to request when guest arch matches the host.
#   QEMU_MEM     Guest memory in MB. Defaults to 2048.
#   QEMU_AUDIODEV Audio backend for virtio-sound (coreaudio|alsa|pa|none|...).
#                Defaults to coreaudio on macOS, none (silent, no host audio
#                dependency) everywhere else.
#   QEMU_GPU     none|virgl|std. Defaults to none, which keeps the serial-only
#                behaviour the boot tests rely on. Mirrors image-builder's
#                display_args: virtio-vga-gl on amd64, virtio-gpu-gl-pci on
#                arm64 (image-builder still uses a plain virtio-gpu-pci there,
#                so arm64 gets no GL under it), plus virtio input devices so a
#                compositor in the guest has a keyboard and pointer. Needs a
#                qemu built with opengl and virglrenderer - stock Homebrew
#                qemu has neither.
#   QEMU_DISPLAY Display backend (cocoa|gtk|sdl|...). Defaults to cocoa on
#                macOS and gtk elsewhere; image-builder hardcodes gtk, which
#                is not available on a mac. Ignored when QEMU_GPU=none.
#   DOWNLOAD_REPO owner/repo the download subcommand pulls artifacts from.
#                Defaults to bbusse/gentoo-build
#   QEMU_GL      es|core|on. GL flavour appended to the display. Defaults to
#                es, which is what ANGLE advertises on macOS

set -eo pipefail

HOST_OS="$(uname -s)"
case "$(uname -m)" in
arm64 | aarch64) HOST_ARCH="arm64" ;;
x86_64 | amd64) HOST_ARCH="amd64" ;;
*)
    printf 'Unsupported host architecture: %s\n' "$(uname -m)" >&2
    exit 1
    ;;
esac

ARCH="${ARCH:-${HOST_ARCH}}"
QEMU_MEM="${QEMU_MEM:-2048}"

if [ "${HOST_OS}" = "Darwin" ]; then
    QEMU_NET="${QEMU_NET:-vmnet-shared}"
    QEMU_AUDIODEV="${QEMU_AUDIODEV:-coreaudio}"
else
    QEMU_NET="${QEMU_NET:-user}"
    QEMU_AUDIODEV="${QEMU_AUDIODEV:-none}"
fi

# Default to a GPU for interactive runs and to none under SERIAL_PIPE, which
# only tests/test_boot_qemu.sh sets: a boot test wants the console on the pipe
# and no window, while running ./run by hand almost always means wanting to
# see the guest
if [ -n "${SERIAL_PIPE}" ]; then
    QEMU_GPU="${QEMU_GPU:-none}"
else
    QEMU_GPU="${QEMU_GPU:-virgl}"
fi
DOWNLOAD_REPO="${DOWNLOAD_REPO:-bbusse/gentoo-build}"
QEMU_GL="${QEMU_GL:-es}"
if [ "${HOST_OS}" = "Darwin" ]; then
    QEMU_DISPLAY="${QEMU_DISPLAY:-cocoa}"
else
    QEMU_DISPLAY="${QEMU_DISPLAY:-gtk}"
fi

case "${ARCH}" in
arm64)
    QEMU_BIN="qemu-system-aarch64"
    QEMU_MACHINE="virt"
    QEMU_CPU="max"
    FIRMWARE_CODE_NAMES=(edk2-aarch64-code.fd AAVMF_CODE.fd QEMU_EFI.fd)
    FIRMWARE_VARS_NAMES=(edk2-arm-vars.fd AAVMF_VARS.fd QEMU_VARS.fd)
    DISK_DEVICE_ARGS=(-device "virtio-blk-pci,drive=disk0,romfile=")
    GLOBAL_ARGS=(-global "virtio-pci.romfile=")
    GPU_DEVICE_GL="virtio-gpu-gl-pci"
    GPU_DEVICE_STD="virtio-gpu-pci"
    ;;
amd64)
    QEMU_BIN="qemu-system-x86_64"
    QEMU_MACHINE="q35"
    QEMU_CPU="qemu64"
    FIRMWARE_CODE_NAMES=(edk2-x86_64-code.fd OVMF_CODE_4M.fd OVMF_CODE.fd OVMF.fd)
    FIRMWARE_VARS_NAMES=(edk2-i386-vars.fd OVMF_VARS_4M.fd OVMF_VARS.fd)
    GPU_DEVICE_GL="virtio-vga-gl"
    GPU_DEVICE_STD="virtio-vga"
    DISK_DEVICE_ARGS=(-device "ahci,id=ahci0" -device "ide-hd,drive=disk0,bus=ahci0.0")
    GLOBAL_ARGS=()
    ;;
*)
    printf 'Unsupported target architecture: %s\n' "${ARCH}" >&2
    exit 1
    ;;
esac

download_image() {
    local target
    target="${1:-gentoo-sway-virt}"
    local arch
    arch="${2:-${ARCH}}"
    local artifact
    artifact="disk-image-${target}-${arch}"
    local raw
    raw="${target}-${arch}.raw"

    for tool in gh python3; do
        if ! command -v "${tool}" >/dev/null 2>&1; then
            printf '%s is required for download\n' "${tool}" >&2
            exit 1
        fi
    done

    printf 'Looking for %s\n' "${artifact}"
    local id
    if ! id="$(gh api "/repos/${DOWNLOAD_REPO}/actions/artifacts?per_page=100" \
            --jq "[.artifacts[] | select(.name == \"${artifact}\") |
                   select(.expired == false)] | first | .id" 2>&1)"; then
        printf 'Artifact lookup failed for %s: %s\n' "${DOWNLOAD_REPO}" "${id}" >&2
        exit 1
    fi
    if [ -z "${id}" ] || [ "${id}" = "null" ]; then
        printf 'No unexpired artifact named %s in %s\n' \
               "${artifact}" "${DOWNLOAD_REPO}" >&2
        exit 1
    fi

    printf 'Downloading artifact %s\n' "${id}"
    gh api "/repos/${DOWNLOAD_REPO}/actions/artifacts/${id}/zip" > "${raw}.zip"

    printf 'Unpacking %s sparsely\n' "${raw}"
    python3 - "${raw}.zip" "${raw}" <<'PYEOF'
import os, sys, zipfile

zip_path, out = sys.argv[1], sys.argv[2]
CHUNK = 1 << 20
zeros = b"\0" * CHUNK
with zipfile.ZipFile(zip_path) as z:
    name = next(n for n in z.namelist() if n.endswith(".raw"))
    total = z.getinfo(name).file_size
    written = 0
    with z.open(name) as src, open(out, "wb") as dst:
        while True:
            buf = src.read(CHUNK)
            if not buf:
                break
            if len(buf) == CHUNK and buf == zeros:
                dst.seek(CHUNK, os.SEEK_CUR)
            else:
                dst.write(buf)
                written += len(buf)
        dst.truncate(total)
print(f"{name}: {total / 2**30:.1f} GiB logical, "
      f"{written / 2**30:.2f} GiB written")
PYEOF

    rm -f "${raw}.zip"
    printf 'Wrote %s\n' "${raw}"
}

if [ "${1:-}" = "download" ]; then
    shift
    download_image "$@"
    exit 0
fi

DISK_IMAGE="${1:-${DISK_IMAGE:-gentoo-containeros-${ARCH}.raw}}"

# vmnet-shared needs root
if [ "${QEMU_NET}" = "vmnet-shared" ] && [ "$(id -u)" -ne 0 ]; then
    exec sudo --preserve-env=ARCH,DISK_IMAGE,SERIAL_PIPE,QEMU_NET,QEMU_ACCEL,QEMU_MEM,QEMU_AUDIODEV,QEMU_GPU,QEMU_DISPLAY,QEMU_GL "$0" "$@"
fi

if ! command -v "${QEMU_BIN}" >/dev/null 2>&1; then
    printf 'qemu binary not found: %s\n' "${QEMU_BIN}" >&2
    printf 'Install qemu (Homebrew: qemu, Debian/Ubuntu: qemu-system-%s)\n' \
        "$([ "${ARCH}" = arm64 ] && printf arm || printf x86)" >&2
    exit 1
fi

firmware_dirs() {
    local qemu_share
    qemu_share="$(dirname "$(command -v "${QEMU_BIN}")")/../share/qemu"
    printf '%s\n' \
        "${qemu_share}" \
        /usr/share/qemu \
        /usr/share/OVMF \
        /usr/share/ovmf \
        /usr/share/AAVMF \
        /usr/share/qemu-efi-aarch64 \
        /usr/share/edk2/ovmf \
        /usr/share/edk2/aarch64 \
        /usr/share/edk2-ovmf
}

find_firmware() {
    local dir name
    for name in "$@"; do
        while read -r dir; do
            if [ -f "${dir}/${name}" ]; then
                printf '%s' "${dir}/${name}"
                return 0
            fi
        done < <(firmware_dirs)
    done
    return 1
}

file_size() {
    stat -f%z "$1" 2>/dev/null || stat -c%s "$1"
}

if [ ! -f "${DISK_IMAGE}" ]; then
    printf 'Disk image not found: %s\n' "${DISK_IMAGE}" >&2
    exit 1
fi

FIRMWARE_CODE="$(find_firmware "${FIRMWARE_CODE_NAMES[@]}")" || {
    printf 'UEFI code firmware not found for arch %s (looked for: %s)\n' \
        "${ARCH}" "${FIRMWARE_CODE_NAMES[*]}" >&2
    exit 1
}

VARS_DIR="$(mktemp -d)"
FIRMWARE_VARS="${VARS_DIR}/firmware-vars.fd"
trap 'rm -rf "${VARS_DIR}"' EXIT

if FIRMWARE_VARS_SRC="$(find_firmware "${FIRMWARE_VARS_NAMES[@]}")"; then
    cp "${FIRMWARE_VARS_SRC}" "${FIRMWARE_VARS}"
else
    FIRMWARE_VARS_SRC="(zeroed, no template found)"
    dd if=/dev/zero of="${FIRMWARE_VARS}" bs=1 count=0 \
        seek="$(file_size "${FIRMWARE_CODE}")" 2>/dev/null
fi

QEMU_MACHINE_ARG="${QEMU_MACHINE}"
if [ "${ARCH}" != "${HOST_ARCH}" ]; then
    QEMU_MACHINE_ARG="${QEMU_MACHINE},accel=tcg"
elif [ -n "${QEMU_ACCEL}" ]; then
    QEMU_MACHINE_ARG="${QEMU_MACHINE},accel=${QEMU_ACCEL}"
fi

# "user" needs a qemu built with libslirp, which the virgl-capable builds
# often are not; allow turning the NIC off rather than failing with
# "network backend 'user' is not compiled into this binary"
case "${QEMU_NET}" in
vmnet-shared)
    NET_ARGS=(-netdev "vmnet-shared,id=net0" -device "virtio-net-pci,netdev=net0,romfile=")
    ;;
none)
    NET_ARGS=(-nic none)
    ;;
*)
    NET_ARGS=(-nic "user,model=virtio-net-pci")
    ;;
esac

AUDIO_ARGS=(-audiodev "${QEMU_AUDIODEV},id=audio0" -device "virtio-sound-pci,audiodev=audio0,romfile=")

# romfile= matches the other virtio devices here: these builds ship no option
# ROMs, and without it the PCI device fails to initialise with
# "failed to find romfile efi-virtio.rom". The input devices come with the
# GPU because a guest with a display and no keyboard or pointer is not much
# use - CONFIG_VIRTIO_INPUT in the guest kernel backs them
case "${QEMU_GPU}" in
none)
    GPU_ARGS=()
    DISPLAY_ARG=""
    ;;
virgl)
    GPU_ARGS=(
        -device "${GPU_DEVICE_GL},romfile="
        -device "virtio-keyboard-pci,romfile="
        -device "virtio-tablet-pci,romfile="
    )
    DISPLAY_ARG="${QEMU_DISPLAY},gl=${QEMU_GL}"
    ;;
std)
    GPU_ARGS=(
        -device "${GPU_DEVICE_STD},romfile="
        -device "virtio-keyboard-pci,romfile="
        -device "virtio-tablet-pci,romfile="
    )
    DISPLAY_ARG="${QEMU_DISPLAY}"
    ;;
*)
    printf 'Unsupported QEMU_GPU: %s (expected none|virgl|std)\n' "${QEMU_GPU}" >&2
    exit 1
    ;;
esac

# SERIAL_PIPE is how tests/test_boot_qemu.sh drives the guest, so the console
# stays on the pipe. Without a GPU keep forcing -display none, which is what
# that test expects; with one, the window is the whole point
if [ -n "${SERIAL_PIPE}" ]; then
    SERIAL_ARGS=(-serial pipe:"${SERIAL_PIPE}")
    if [ "${QEMU_GPU}" = none ]; then
        SERIAL_ARGS+=(-display none)
    else
        SERIAL_ARGS+=(-display "${DISPLAY_ARG}")
    fi
elif [ "${QEMU_GPU}" = none ]; then
    SERIAL_ARGS=(-nographic)
else
    # Keep the console in the terminal while the guest window is open
    SERIAL_ARGS=(-serial mon:stdio -display "${DISPLAY_ARG}")
fi

printf 'Host:          %s/%s\n' "${HOST_OS}" "${HOST_ARCH}"
printf 'Target arch:   %s\n' "${ARCH}"
printf 'Machine:       %s\n' "${QEMU_MACHINE_ARG}"
printf 'Disk image:    %s\n' "${DISK_IMAGE}"
printf 'Firmware code: %s\n' "${FIRMWARE_CODE}"
printf 'Firmware vars: %s\n' "${FIRMWARE_VARS_SRC}"
printf 'Networking:    %s\n' "${QEMU_NET}"
printf 'Audio:         %s\n' "${QEMU_AUDIODEV}"
printf 'GPU:           %s\n' "${QEMU_GPU}"
if [ "${QEMU_GPU}" != none ]; then
    printf 'Display:       %s\n' "${DISPLAY_ARG}"
fi
printf '\n'

exec "${QEMU_BIN}" \
    -m "${QEMU_MEM}" \
    -machine "${QEMU_MACHINE_ARG}" \
    -cpu "${QEMU_CPU}" \
    -no-reboot \
    "${GLOBAL_ARGS[@]}" \
    "${SERIAL_ARGS[@]}" \
    "${NET_ARGS[@]}" \
    "${AUDIO_ARGS[@]}" \
    "${GPU_ARGS[@]}" \
    -drive if=pflash,format=raw,readonly=on,file="${FIRMWARE_CODE}" \
    -drive if=pflash,format=raw,file="${FIRMWARE_VARS}" \
    -drive if=none,format=raw,file="${DISK_IMAGE}",id=disk0 \
    "${DISK_DEVICE_ARGS[@]}"
